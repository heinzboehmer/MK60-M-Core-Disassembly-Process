+# psrclr/psrset: imm3 selects the PSR field. More specific than mfcr
+# (bits 15..3 fixed), so they take the 0x11F0-0x11FF (cr=31) encodings.
+:psrclr psrimm is op3_15=0b0001000111110 & psrimm {
+	psrclr_op(psrimm:1);
+}
+:psrset psrimm is op3_15=0b0001000111111 & psrimm {
+	psrset_op(psrimm:1);
+}
