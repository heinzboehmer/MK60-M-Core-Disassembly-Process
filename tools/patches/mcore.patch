+# addi/subi/cmplti encode a one-based immediate (OIMM5 = field + 1, range 1..32),
+# per the M-CORE RM and binutils mcore-opc.h. The raw field alone is off by one.
+oneImm5: val is oimm5 [ val = oimm5 + 1; ] { export *[const]:4 val; }
+define pcodeop psrclr_op;
+define pcodeop psrset_op;
 
